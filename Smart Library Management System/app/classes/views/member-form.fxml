<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.slms.controllers.MemberFormController"
      spacing="16" styleClass="app-root" prefWidth="600">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label fx:id="formTitle" text="Add New Member" styleClass="section-title"/>

    <HBox spacing="20">
        <!-- Photo Picker -->
        <VBox spacing="10" alignment="TOP_CENTER">
            <ImageView fx:id="photoView" fitWidth="120" fitHeight="150" style="-fx-border-color: #ccc; -fx-border-width: 1;" preserveRatio="true"/>
            <Button text="Choose Photo" onAction="#handleChoosePhoto"/>
        </VBox>

        <!-- Form Fields -->
        <GridPane hgap="10" vgap="10" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints minWidth="80"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                <ColumnConstraints minWidth="80"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            </columnConstraints>

            <Label text="Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

            <Label text="Roll No. *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="rollField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Phone" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

            <Label text="Department" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="deptField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Course" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <TextField fx:id="courseField" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

            <Label text="Semester" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="semesterField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Status" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <ComboBox fx:id="statusCombo" GridPane.rowIndex="4" GridPane.columnIndex="3" prefWidth="150"/>

            <Label text="Joining Date" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <DatePicker fx:id="joiningDatePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="150"/>

            <Label text="Address" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextArea fx:id="addressArea" prefRowCount="3" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
        </GridPane>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" cancelButton="true" onAction="#handleCancel"/>
        <Button text="Save Member" defaultButton="true" styleClass="primary-button" onAction="#handleSave"/>
    </HBox>
</VBox>
