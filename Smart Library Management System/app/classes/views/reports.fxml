<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.slms.controllers.ReportsController"
            styleClass="app-root">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <center>
        <VBox spacing="20" padding="20">
            <Label text="Library Reports" styleClass="section-title"/>
            
            <HBox spacing="20">
                <VBox spacing="10" styleClass="stat-card" style="-fx-padding: 20;" prefWidth="300">
                    <Label text="Inventory Report" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Label text="Export a complete list of all books, their categories, and current availability to an Excel file." wrapText="true"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Generate Excel" styleClass="primary-button" onAction="#generateInventoryReport"/>
                </VBox>

                <VBox spacing="10" styleClass="stat-card" style="-fx-padding: 20;" prefWidth="300">
                    <Label text="Fines Report" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Label text="Export a report of all fines across the library including pending and paid fines." wrapText="true"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Generate Excel" styleClass="primary-button" onAction="#generateFinesReport"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
