<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.slms.controllers.SettingsController"
            styleClass="app-root">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <center>
        <VBox spacing="20" padding="20">
            <Label text="User Management (ADMIN)" styleClass="section-title"/>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="usernameField" promptText="Username" prefWidth="150"/>
                <PasswordField fx:id="passwordField" promptText="Password" prefWidth="150"/>
                <TextField fx:id="fullNameField" promptText="Full Name" prefWidth="200"/>
                <ComboBox fx:id="roleCombo" prefWidth="120"/>
                <Button fx:id="addUserBtn" text="Add User" styleClass="primary-button" onAction="#addUser"/>
            </HBox>

            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No users found." styleClass="empty-state-label"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="usernameCol" text="Username" prefWidth="150"/>
                    <TableColumn fx:id="nameCol" text="Full Name" prefWidth="200"/>
                    <TableColumn fx:id="roleCol" text="Role" prefWidth="100"/>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="100" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
