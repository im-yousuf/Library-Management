<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.slms.controllers.LoginController"
           styleClass="login-root">

    <VBox alignment="CENTER" spacing="18" maxWidth="360" styleClass="login-card">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="📚" style="-fx-font-size: 40px;"/>
        <Label text="Smart Library Management System" wrapText="true" styleClass="login-title"/>
        <Label text="Sign in to continue" styleClass="login-subtitle"/>

        <VBox spacing="6">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="Enter username"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Password"/>
            <StackPane>
                <PasswordField fx:id="passwordField" promptText="Enter password"/>
                <TextField fx:id="passwordVisibleField" promptText="Enter password"/>
            </StackPane>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <CheckBox fx:id="rememberMeCheck" text="Remember Me"/>
            <CheckBox fx:id="showPasswordCheck" text="Show Password"/>
        </HBox>

        <Button fx:id="loginButton" text="Login" maxWidth="Infinity" styleClass="primary-button" onAction="#handleLogin"/>

        <Hyperlink text="Forgot Password? (Admin)" onAction="#handleForgotPassword"/>

        <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>

        <Label text="Default admin login: admin / admin123" styleClass="hint-label"/>
    </VBox>

</StackPane>
