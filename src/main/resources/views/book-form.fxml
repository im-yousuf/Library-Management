<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.slms.controllers.BookFormController"
      spacing="16" styleClass="app-root" prefWidth="600">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label fx:id="formTitle" text="Add New Book" styleClass="section-title"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="80"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints minWidth="80"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
        </columnConstraints>

        <Label text="Title *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

        <Label text="Subtitle" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="subtitleField" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

        <Label text="Author" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="authorField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="ISBN" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="isbnField" promptText="e.g. 978-..." GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Publisher" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="publisherField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Edition" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <TextField fx:id="editionField" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

        <Label text="Category" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <HBox spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <ComboBox fx:id="categoryCombo" prefWidth="120"/>
            <Button text="+" onAction="#handleAddCategory"/>
        </HBox>
        <Label text="Language" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <TextField fx:id="languageField" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

        <Label text="Pub. Year" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="yearField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Price" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        <TextField fx:id="priceField" text="0.0" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

        <Label text="Quantity *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <VBox GridPane.rowIndex="6" GridPane.columnIndex="1">
            <TextField fx:id="quantityField" text="1"/>
            <Label text="New: Avail copies match qty" style="-fx-font-size: 10px; -fx-text-fill: gray;"/>
        </VBox>
        <Label text="Purchase Date" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
        <DatePicker fx:id="purchaseDatePicker" GridPane.rowIndex="6" GridPane.columnIndex="3" prefWidth="150"/>

        <Label text="Description" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionArea" prefRowCount="3" GridPane.rowIndex="8" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
        
        <Label text="Shelf" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <ComboBox fx:id="shelfCombo" GridPane.rowIndex="7" GridPane.columnIndex="1" prefWidth="150"/>
        <Label text="Position" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
        <TextField fx:id="positionField" GridPane.rowIndex="7" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" cancelButton="true" onAction="#handleCancel"/>
        <Button text="Save Book" defaultButton="true" styleClass="primary-button" onAction="#handleSave"/>
    </HBox>
</VBox>
