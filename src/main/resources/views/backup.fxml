<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.slms.controllers.BackupController"
            styleClass="app-root">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <center>
        <VBox spacing="20" padding="20" alignment="CENTER">
            <Label text="Database Backup &amp; Restore" styleClass="section-title"/>
            
            <VBox spacing="15" alignment="CENTER" maxWidth="400" styleClass="stat-card" style="-fx-padding: 30;">
                <Label text="Create a backup of your database regularly to prevent data loss." wrapText="true" textAlignment="CENTER"/>
                <Button text="Create Backup" styleClass="primary-button" prefWidth="200" onAction="#createBackup"/>
                
                <Separator/>
                
                <Label text="Restore from an existing backup (Admin Only)." wrapText="true" textAlignment="CENTER"/>
                <Button text="Restore Backup" styleClass="nav-button" prefWidth="200" style="-fx-background-color: #f44336; -fx-text-fill: white;" onAction="#restoreBackup"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
