<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.slms.controllers.FinesController"
            styleClass="app-root">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <center>
        <VBox spacing="10" padding="20">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Fine Management" styleClass="section-title"/>
                <ToggleGroup fx:id="filterGroup"/>
                <RadioButton text="All" toggleGroup="$filterGroup" selected="true" onAction="#applyFilter"/>
                <RadioButton text="Pending" toggleGroup="$filterGroup" onAction="#applyFilter"/>
                <RadioButton text="Paid" toggleGroup="$filterGroup" onAction="#applyFilter"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Total Pending:"/>
                <Label fx:id="totalPendingLabel" text="0" styleClass="stat-value"/>
            </HBox>

            <TableView fx:id="finesTable" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No fines found." styleClass="empty-state-label"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="memberCol" text="Member" prefWidth="150"/>
                    <TableColumn fx:id="bookCol" text="Book" prefWidth="150"/>
                    <TableColumn fx:id="amountCol" text="Amount" prefWidth="80"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="80"/>
                    <TableColumn fx:id="dueDateCol" text="Due Date" prefWidth="120"/>
                    <TableColumn fx:id="daysOverdueCol" text="Days Overdue" prefWidth="100"/>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="180" sortable="false"/>
                </columns>
            </TableView>

            <Separator/>
            <VBox spacing="8">
                <Label text="Fine Settings (ADMIN only)" style="-fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Fine per day:"/>
                    <TextField fx:id="finePerDayField" prefWidth="80"/>
                    <Label text="Grace days:"/>
                    <TextField fx:id="graceDaysField" prefWidth="50"/>
                    <Button text="Save" styleClass="primary-button" onAction="#saveFineSettings"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
