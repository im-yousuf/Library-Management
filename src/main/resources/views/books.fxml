<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.slms.controllers.BooksController"
            styleClass="app-root">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Book Management" styleClass="section-title"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Search title, author, ISBN, category..." prefWidth="300"/>
                <Button text="➕ Add Book" styleClass="primary-button" onAction="#handleAddBook"/>
            </HBox>

            <TableView fx:id="booksTable" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No books found." styleClass="empty-state-label"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="titleCol" text="Title" prefWidth="220"/>
                    <TableColumn fx:id="authorCol" text="Author" prefWidth="150"/>
                    <TableColumn fx:id="isbnCol" text="ISBN" prefWidth="100"/>
                    <TableColumn fx:id="categoryCol" text="Category" prefWidth="130"/>
                    <TableColumn fx:id="locationCol" text="Location" prefWidth="150"/>
                    <TableColumn fx:id="copiesCol" text="Copies" prefWidth="100"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="140" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
