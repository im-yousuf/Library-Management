<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.slms.controllers.LibraryLayoutController"
            styleClass="app-root">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <center>
        <SplitPane dividerPositions="0.3">
            <!-- Left Panel: Racks & Shelves Tree -->
            <VBox spacing="10">
                <padding><Insets top="20" right="10" bottom="20" left="20"/></padding>
                <Label text="Library Layout" styleClass="section-title"/>
                
                <TreeView fx:id="layoutTreeView" VBox.vgrow="ALWAYS" showRoot="false"/>
                
                <HBox spacing="10">
                    <Button text="Add Rack" onAction="#handleAddRack"/>
                    <Button text="Add Shelf" onAction="#handleAddShelf"/>
                </HBox>
                <HBox spacing="10">
                    <Button text="Rename" onAction="#handleRename"/>
                    <Button text="Delete" onAction="#handleDelete" styleClass="logout-button"/>
                </HBox>
            </VBox>

            <!-- Right Panel: Shelf Contents & Assignment -->
            <VBox spacing="15">
                <padding><Insets top="20" right="20" bottom="20" left="10"/></padding>
                
                <Label fx:id="shelfTitleLabel" text="Select a Shelf" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <TableView fx:id="booksTable" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No books assigned to this shelf." styleClass="empty-state-label"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="titleCol" text="Title" prefWidth="250"/>
                        <TableColumn fx:id="authorCol" text="Author" prefWidth="200"/>
                        <TableColumn fx:id="positionCol" text="Position" prefWidth="150"/>
                        <TableColumn fx:id="actionsCol" text="Action" prefWidth="100"/>
                    </columns>
                </TableView>
                
                <!-- Assign Book Area -->
                <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-color: #ccc; -fx-border-radius: 4;">
                    <Label text="Assign Book to this Shelf" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Search Book:"/>
                        <TextField fx:id="bookSearchField" promptText="Title or ISBN..."/>
                        <ComboBox fx:id="bookCombo" prefWidth="250"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Position:"/>
                        <TextField fx:id="positionField" promptText="e.g. Left End, Top Row"/>
                        <Button text="Assign" styleClass="primary-button" onAction="#handleAssignBook"/>
                    </HBox>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
